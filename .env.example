# Copy this file to .env and fill in real values. Never commit .env.

## ---- Postgres ----
POSTGRES_DB=watchlog
POSTGRES_USER=watchlog
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432
ConnectionStrings__Default=Host=postgres;Port=5432;Database=watchlog;Username=watchlog;Password=change-me-locally

## ---- Redis ----
REDIS_PORT=6379
ConnectionStrings__Redis=redis:6379

## ---- JWT ----
Jwt__Issuer=watchlog.local
Jwt__Audience=watchlog.clients
Jwt__SigningKey=replace-with-a-long-random-secret-at-least-32-chars
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30

## ---- TMDB ----
# Get a free key at https://www.themoviedb.org/settings/api
Tmdb__ApiKey=
Tmdb__BaseUrl=https://api.themoviedb.org/3
Tmdb__ImageBaseUrl=https://image.tmdb.org/t/p/

## ---- OAuth providers (leave blank to disable a provider) ----
Auth__Google__ClientId=
Auth__Google__ClientSecret=
Auth__Microsoft__ClientId=
Auth__Microsoft__ClientSecret=
Auth__Apple__ClientId=
Auth__Apple__TeamId=
Auth__Apple__KeyId=
Auth__Apple__PrivateKey=
Auth__Facebook__AppId=
Auth__Facebook__AppSecret=

## ---- Passkeys (WebAuthn / Fido2) ----
Fido2__ServerDomain=localhost
Fido2__ServerName=WatchLog
Fido2__Origins=https://localhost:5173

## ---- API ----
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
API_PORT=8080
Admin__InitialAdminEmail=

## ---- Web app (Flutter) ----
WEB_PORT=8081

## ---- Admin dashboard (phase 3) ----
VITE_API_BASE_URL=http://localhost:8080
